@if (Answer.Trace.Count > 0)
{
    <details class="disclosure trace">
        <summary>
            @Ui["answer.trace"]
            <span class="muted small"> · <bdi>@Ui.F("answer.time", Answer.DurationMs / 1000.0)</bdi></span>
        </summary>
        <ol>
            @foreach (var t in Answer.Trace)
            {
                <li class="@(t.Ok ? "ok" : "fail")">
                    <span class="trace-tool">@Ui.Report(t.Tool)</span>
                    <code dir="ltr">@($"{t.Tool}({t.ArgumentsJson})")</code>
                    <span class="trace-meta">
                        @if (t.Ok)
                        {
                            <span class="badge badge-ok">@Ui.F("answer.trace.rows", t.RowCount ?? 0)</span>
                        }
                        else
                        {
                            <span class="badge badge-fail">@t.ErrorCode</span>
                        }
                        <span class="muted small"><bdi>@t.DurationMs ms</bdi></span>
                    </span>
                </li>
            }
        </ol>
    </details>
}

@code {
    [CascadingParameter] private Ui Ui { get; set; } = default!;
    [Parameter, EditorRequired] public AgentAnswer Answer { get; set; } = default!;
}
