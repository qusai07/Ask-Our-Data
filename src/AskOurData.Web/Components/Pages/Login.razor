@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject Microsoft.Extensions.Options.IOptions<WebOptions> Options

<PageTitle>@Ui["login.title"] · @Ui["app.name"]</PageTitle>

<div class="login-page">
    <header class="login-top">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 17v-6M12 17V7M18 17v-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none" /></svg>
            </span>
            <span class="brand-name">@Ui["app.name"]</span>
        </div>
        <a class="btn btn-ghost" href="/culture/@(Ui.Rtl ? "en" : "ar")?returnUrl=/login" data-enhance-nav="false"
           aria-label="@Ui["nav.language.aria"]" lang="@(Ui.Rtl ? "en" : "ar")">@Ui["nav.language"]</a>
    </header>

    <main class="login-card">
        <h1>@Ui["login.title"]</h1>
        <p class="muted">@Ui["app.tagline"]</p>

        @if (HasError)
        {
            <div class="notice notice-danger" role="alert">@(Ui.Rtl ? "تعذّر تسجيل الدخول. تأكد من تشغيل خدمة التقارير." : "Sign-in failed. Make sure the report service is running.")</div>
        }

        @if (Options.Value.AuthMode == "Dev")
        {
            <p class="login-note">@Ui["login.subtitle"]</p>
            <form method="post" action="/auth/dev-login" class="user-list" data-enhance="false">
                <AntiforgeryToken />
                @foreach (var u in DemoUsers)
                {
                    <button type="submit" name="user" value="@u" class="user-option">
                        <span class="avatar" aria-hidden="true">@char.ToUpperInvariant(u[0])</span>
                        <span class="user-text">
                            <span class="user-name">@(char.ToUpperInvariant(u[0]) + u[1..])</span>
                            <span class="user-desc">@Ui["login.user." + u]</span>
                        </span>
                        <span class="chev" aria-hidden="true">›</span>
                    </button>
                }
            </form>
        }
        else
        {
            <a class="btn btn-primary btn-block" href="/auth/signin" data-enhance-nav="false">@Ui["login.prod"]</a>
        }
    </main>
</div>

@code {
    [CascadingParameter] private Ui Ui { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }

    private bool HasError => Error is not null;

    private static readonly string[] DemoUsers = ["fiona", "rita", "sam", "erin", "nora", "ian", "ghost"];
}
