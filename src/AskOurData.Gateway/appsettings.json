{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "ReportingConnectionString": "Server=localhost;Database=AskData_Reporting;Integrated Security=true;TrustServerCertificate=true",
    "OpsConnectionString": "Server=localhost\\SQL22;Database=AskData_Ops;Integrated Security=true;TrustServerCertificate=true",
    "ReportingImpersonateUser": null,
    "OpsImpersonateUser": null,
    "CatalogPath": "catalog",
    "CommandTimeoutSeconds": 15,
    "MaxRows": 100,
    "MaxResultBytes": 262144,
    "MaxRangeMonths": 24,
    "MinDate": "2020-01-01",
    "FiscalYearStartMonth": 4,
    "TimeZone": "Asia/Dubai",
    "ToolCallsPerMinutePerUser": 60
  },
  "Auth": {
    "Mode": "Entra",
    "Entra": {
      "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
      "Audience": "api://ask-our-data-gateway"
    }
  }
}